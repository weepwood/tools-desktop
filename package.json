{
  "name": "tools-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Electron recreation of XIMA Desktop",
  "main": "electron/main.cjs",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 1420 --strictPort\" \"wait-on http://127.0.0.1:1420 && cross-env XIMA_DEV_URL=http://127.0.0.1:1420 electron .\"",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.cjs",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win nsis portable --publish never",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.weepwood.xima.electron",
    "productName": "XIMA Tools",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/ffmpeg-static/**",
      "**/ffprobe-static/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "XIMA-Tools-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "XIMA-Tools-Portable-${version}-${arch}.${ext}"
    }
  },
  "author": "weepwood",
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.28.2": true
  }
}
